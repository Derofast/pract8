<Window x:Class="pract8.zadacha12"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:pract8"
        mc:Ignorable="d"
        Title="zadacha12" Height="450" Width="800">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition/>
            <RowDefinition/>
        </Grid.RowDefinitions>
        <Grid.ColumnDefinitions>
            <ColumnDefinition/>
            <ColumnDefinition/>
        </Grid.ColumnDefinitions>
        <TextBlock Text="Введите число n" FontSize="30"/>
        <TextBox x:Name="chN" Grid.Row="0" Grid.Column="1"/>
        <Button Click="Button_Click"  Grid.Row="2" Content="Вычислить" FontSize="30"/>
        <Label x:Name="lab" Grid.Row="1" Grid.Column="1"/>
        <Image Grid.Column="1" Margin="0,30" Source="Image1.png" Stretch="Fill"/>
    </Grid>
</Window>
