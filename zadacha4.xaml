<Window x:Class="pract8.zadacha4"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:pract8"
        mc:Ignorable="d"
        Title="zadacha4" Height="600" Width="800">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition/>
            <RowDefinition Height="2*"/>
        </Grid.RowDefinitions>
        <Grid.ColumnDefinitions>
            <ColumnDefinition/>
            <ColumnDefinition/>
        </Grid.ColumnDefinitions>
        <TextBlock Text="Введите цену за 1кг сыра" FontSize="30"/>
        <TextBox x:Name="chK" Grid.Column="1" />
        <Button Click="Button_Click" Grid.Row="2" Content="Вычислить" FontSize="30"/>
        <ListBox x:Name="lab" Grid.Row="1" Grid.Column="1"/>
        <Image Margin="0,127,10,5" Source="Image16.png" Stretch="Fill"/>
    </Grid>
</Window>
